{
	"name": "nuci",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "pnpm --filter @nuci/web dev",
		"build": "pnpm --filter @nuci/web build",
		"test": "pnpm test:unit && pnpm test:ucode",
		"test:unit": "vitest run",
		"test:ucode": "sh rpcd/test/run.sh",
		"check": "pnpm -r --parallel check && sh tools/check-ucode.sh",
		"lint": "eslint . && prettier --check . && sh tools/check-license.sh && node tools/check-i18n.mjs",
		"format": "prettier --write .",
		"size": "node tools/size.mjs",
		"e2e": "bash e2e/run.sh"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.19.2",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	}
}
