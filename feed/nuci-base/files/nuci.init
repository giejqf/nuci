#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# Applies nuci uci settings that live outside the SPA (currently: / redirect).

START=99
USE_PROCD=1

start_service() {
	/usr/libexec/nuci/root-redirect
}

service_triggers() {
	procd_add_reload_trigger nuci
}

reload_service() {
	start_service
}
