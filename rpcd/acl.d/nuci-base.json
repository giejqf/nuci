{
	"unauthenticated": {
		"description": "NuCI: pre-login board info for the login screen",
		"read": {
			"ubus": {
				"system": [
					"board"
				]
			}
		}
	},
	"nuci-base": {
		"description": "NuCI: shell, session, installed apps, heartbeat stream",
		"read": {
			"ubus": {
				"session": [
					"access",
					"destroy",
					"list"
				],
				"system": [
					"board",
					"info"
				],
				"nuci.apps": [
					"list"
				]
			},
			"nuci-events": [
				"heartbeat"
			]
		}
	},
	"nuci-uci": {
		"description": "NuCI: uci staging and the apply/confirm/rollback protocol (per-config access is granted by the area groups)",
		"read": {
			"ubus": {
				"uci": [
					"configs",
					"get",
					"state",
					"changes"
				]
			}
		},
		"write": {
			"ubus": {
				"uci": [
					"set",
					"add",
					"delete",
					"rename",
					"order",
					"revert",
					"apply",
					"confirm",
					"rollback"
				]
			}
		}
	},
	"nuci-status": {
		"description": "NuCI: Status pages (overview, logs, processes, realtime graphs)",
		"read": {
			"ubus": {
				"network.interface": [
					"dump"
				],
				"network.interface.*": [
					"status"
				],
				"network.device": [
					"status"
				],
				"iwinfo": [
					"devices",
					"info",
					"assoclist"
				],
				"dhcp": [
					"ipv6leases"
				],
				"log": [
					"read"
				],
				"nuci.status": [
					"realtime",
					"processes",
					"kernel_log",
					"conntrack",
					"conntrack_summary"
				],
				"nuci.dhcp": [
					"leases",
					"hosts"
				],
				"nuci.wifi": [
					"status"
				]
			},
			"nuci-events": [
				"stats",
				"syslog",
				"kernlog",
				"conntrack",
				"wifi"
			],
			"uci": [
				"dhcp",
				"network",
				"wireless"
			]
		},
		"write": {
			"ubus": {
				"nuci.status": [
					"signal"
				]
			}
		}
	},
	"nuci-system": {
		"description": "NuCI: System pages (general settings, startup, reboot)",
		"read": {
			"ubus": {
				"nuci.system": [
					"timezones",
					"localtime",
					"leds",
					"block_devices",
					"mount_points",
					"usb_devices"
				],
				"rc": [
					"list"
				],
				"file": [
					"read",
					"stat"
				]
			},
			"uci": [
				"system",
				"nuci"
			],
			"file": {
				"/etc/rc.local": [
					"read"
				]
			}
		},
		"write": {
			"ubus": {
				"nuci.system": [
					"set_localtime"
				],
				"rc": [
					"init"
				],
				"system": [
					"reboot"
				],
				"file": [
					"write"
				]
			},
			"uci": [
				"system",
				"nuci"
			],
			"file": {
				"/etc/rc.local": [
					"write"
				]
			}
		}
	},
	"nuci-network": {
		"description": "NuCI: Network pages (interfaces, devices, wireless, DHCP/DNS, routes, diagnostics)",
		"read": {
			"ubus": {
				"network.interface": [
					"dump"
				],
				"network.interface.*": [
					"status"
				],
				"network.device": [
					"status"
				],
				"iwinfo": [
					"devices",
					"info",
					"assoclist",
					"freqlist",
					"txpowerlist",
					"countrylist",
					"phyname"
				],
				"nuci.wifi": [
					"status",
					"assoc_list_enriched"
				],
				"nuci.dhcp": [
					"leases",
					"hosts"
				],
				"nuci.diag": [
					"status"
				]
			},
			"uci": [
				"network",
				"dhcp",
				"wireless",
				"firewall"
			]
		},
		"write": {
			"ubus": {
				"network.interface.*": [
					"up",
					"down",
					"renew"
				],
				"nuci.wifi": [
					"scan"
				],
				"nuci.diag": [
					"ping",
					"traceroute",
					"nslookup"
				]
			},
			"uci": [
				"network",
				"dhcp",
				"wireless",
				"firewall"
			]
		}
	},
	"nuci-admin": {
		"description": "NuCI: Administration (root password, SSH, web server)",
		"read": {
			"ubus": {
				"file": [
					"read",
					"stat"
				]
			},
			"uci": [
				"dropbear",
				"uhttpd",
				"network"
			],
			"file": {
				"/etc/dropbear/authorized_keys": [
					"read"
				]
			}
		},
		"write": {
			"ubus": {
				"rpc-sys": [
					"password_set"
				],
				"file": [
					"write",
					"remove"
				],
				"rc": [
					"init"
				]
			},
			"uci": [
				"dropbear",
				"uhttpd"
			],
			"file": {
				"/etc/dropbear/authorized_keys": [
					"write"
				],
				"/etc/uhttpd.crt": [
					"write"
				],
				"/etc/uhttpd.key": [
					"write"
				]
			}
		}
	},
	"nuci-software": {
		"description": "NuCI: Software (apk packages)",
		"read": {
			"ubus": {
				"nuci.pkg": [
					"list_installed",
					"list_available",
					"search",
					"info",
					"job_status"
				]
			}
		},
		"write": {
			"ubus": {
				"nuci.pkg": [
					"update",
					"add",
					"del"
				]
			}
		}
	},
	"nuci-backup": {
		"description": "NuCI: Backup, restore and firmware upgrade",
		"read": {
			"ubus": {
				"nuci.system": [
					"backup_status"
				],
				"file": [
					"read",
					"stat"
				]
			},
			"file": {
				"/tmp/nuci-backup.tar.gz": [
					"read"
				]
			}
		},
		"write": {
			"ubus": {
				"nuci.system": [
					"backup_create",
					"backup_restore"
				],
				"file": [
					"write",
					"remove"
				],
				"system": [
					"validate_firmware_image",
					"sysupgrade",
					"reboot"
				]
			},
			"file": {
				"/tmp/nuci-restore.tar.gz": [
					"write"
				],
				"/tmp/firmware.bin": [
					"write"
				]
			}
		}
	}
}
