{
	"nuci-e2e": {
		"description": "Test-only (e2e/run.sh installs it on the lab, never packaged): router setup and cleanup for specs (incl. the frp server the frpc spec connects to), and the installed-package list owut sees (upgrade.spec)",
		"read": {
			"ubus": {
				"rpc-sys": [
					"packagelist"
				]
			},
			"uci": [
				"frps"
			]
		},
		"write": {
			"ubus": {
				"file": [
					"exec"
				]
			},
			"file": {
				"/bin/passwd": [
					"exec"
				],
				"/bin/cp": [
					"exec"
				],
				"/bin/rm": [
					"exec"
				],
				"/etc/init.d/network": [
					"exec"
				],
				"/etc/init.d/system": [
					"exec"
				],
				"/usr/sbin/nft": [
					"exec"
				],
				"/tmp/nuci-e2e-ca.pem": [
					"write"
				],
				"/bin/chmod": [
					"exec"
				],
				"/etc/init.d/frps": [
					"exec"
				],
				"/bin/uclient-fetch": [
					"exec"
				],
				"/bin/mkdir": [
					"exec"
				],
				"/tmp/nuci-e2e-media/*": [
					"write"
				]
			},
			"uci": [
				"frps"
			]
		}
	}
}
